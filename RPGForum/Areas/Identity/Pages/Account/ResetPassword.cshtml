@page
@model RPGForum.Areas.Identity.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Nova Palavra-passe";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="glass-card p-5">
            <div class="text-center mb-4">
                <h2 class="title fw-black">🔒 Nova Palavra-passe</h2>
                <p class="text-muted">Define uma nova palavra-passe para a tua conta.</p>
            </div>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                <input type="hidden" asp-for="Input.Token" />
                <input type="hidden" asp-for="Input.Email" />
                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label fw-semibold">Nova Palavra-passe</label>
                    <input asp-for="Input.Password" type="password" class="form-control form-control-custom" placeholder="Pelo menos 6 caracteres..." />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold">Confirmar Palavra-passe</label>
                    <input asp-for="Input.ConfirmPassword" type="password" class="form-control form-control-custom" placeholder="Repete a palavra-passe..." />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="w-100 btn btn-primary mb-3">Alterar Palavra-passe</button>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
