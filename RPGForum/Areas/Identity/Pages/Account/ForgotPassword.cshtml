@page
@model RPGForum.Areas.Identity.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "Recuperar Palavra-Passe";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="glass-card p-5">
            <div class="text-center mb-4">
                <h2 class="title fw-black">🔑 Recuperar Palavra-passe</h2>
                <p class="text-muted">Introduz o teu email para receberes um link de redefinição.</p>
            </div>
            @if (Model.EmailSent)
            {
                <div class="alert alert-success text-center">
                    Enviámos as instruções de recuperação para o teu email! Verifica a tua caixa de entrada.
                </div>
                <div class="text-center mt-3">
                    <a asp-page="./Login" class="btn btn-outline-secondary">Voltar ao Login</a>
                </div>
            }
            else
            {
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    <div class="mb-4">
                        <label asp-for="Input.Email" class="form-label fw-semibold">Endereço de Email</label>
                        <input asp-for="Input.Email" class="form-control form-control-custom" placeholder="o-teu-email@mail.com" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="w-100 btn btn-primary mb-3">Enviar Link de Recuperação</button>
                    <div class="text-center">
                        <a asp-page="./Login" class="friendly-link small">Lembrei-me da palavra-passe</a>
                    </div>
                </form>
            }
        </div>
    </div>
</div>
